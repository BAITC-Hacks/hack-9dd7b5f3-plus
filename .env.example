# ---------- backend ----------
PORT=8080
DATABASE_URL=postgres://plus:plus@db:5432/plus?sslmode=disable
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# voice (STT/TTS) — empty keys + LLM_PROVIDER=mock = keyless mock mode
GEKO_API_KEY=
ELEVENLABS_API_KEY=
# optional, not on the KZ/RU path
SPEKO_API_KEY=
# any OpenAI-compatible API (OpenRouter, Groq, Gemini, Ollama...)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
CORS_ORIGINS=http://localhost:3000
# ---------- frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8080
# mock = everything runs in the browser (no backend, no keys); real = Go backend via NEXT_PUBLIC_API_URL
NEXT_PUBLIC_API_MODE=mock

# frontend/core-llm integration (Compose)
NEXT_PUBLIC_API_MODE=mock
FRONTEND_PORT=3000
# OpenRouter key and model belong in core-llm/.env; see that example.

# ElevenLabs TTS via voice service (--profile voice); key stays server-side.
# ELEVENLABS_API_KEY is declared above.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_ID_KK=
ELEVENLABS_TTS_MODEL_RU=eleven_flash_v2_5
ELEVENLABS_TTS_MODEL_KK=eleven_v3_conversational
