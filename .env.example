# ---------- Voice Router backend ----------
# Everything below is optional: with no keys the app runs in keyless mode
# (lexical router + browser speech APIs). Copy to .env and fill what you have.
PORT=8080
DATA_DIR=../data              # starter kit folder (docker compose sets /app/data)
VAR_DIR=./var                 # traces.jsonl, predictions, eval results
CORS_ORIGINS=*
DEBUG=true                    # include prompts / raw model output in traces & debug stream

# --- LLM (routing + dialogue). Any OpenAI-compatible chat-completions API.
LLM_PROVIDER=                 # empty = auto (openai when a key is set, else mock) | mock | openai
LLM_BASE_URL=https://api.openai.com/v1   # OpenAI; or https://api.groq.com/openai/v1, http://localhost:11434/v1 (Ollama), ...
LLM_API_KEY=                  # falls back to OPENAI_API_KEY
LLM_MODEL=gpt-4.1-mini        # gpt-4.1-nano is faster, gpt-4.1 more accurate; Groq: llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=600
LLM_JSON_MODE=true
LLM_TIMEOUT_MS=20000
LLM_PROMPT_EXAMPLES=1       # catalog examples per language in the cached system prompt (1 ≈ 9k tokens, 2 ≈ 11k)

# --- Shared keys (used as defaults by the providers below)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# --- STT. Empty = auto: elevenlabs_realtime if ELEVENLABS_API_KEY, else openai if OPENAI_API_KEY, else browser.
STT_PROVIDER=                 # browser | mock | elevenlabs_realtime | elevenlabs | openai
STT_BASE_URL=                 # openai: https://api.openai.com/v1 | geko Seta: https://geko--seta-serve-transcriber-api.modal.run/v1 | speaches/whisper: http://localhost:8000/v1
STT_API_KEY=
STT_MODEL=                    # openai: gpt-4o-mini-transcribe | geko: seta-kk-ru-v2 | elevenlabs: scribe_v2
STT_LANGUAGE=                 # hint, e.g. ru; empty = auto-detect (recommended for RU/KZ code-switching)
STT_SECONDARY_LANGUAGES=kk    # elevenlabs_realtime only

# --- TTS. Empty = auto: elevenlabs if ELEVENLABS_API_KEY, else openai if OPENAI_API_KEY, else browser.
TTS_PROVIDER=                 # browser | elevenlabs | openai
TTS_BASE_URL=                 # openai: https://api.openai.com/v1 | geko Tokay (Kazakh): https://geko--tokay-serve-web.modal.run/v1
TTS_API_KEY=
TTS_MODEL=                    # elevenlabs: eleven_flash_v2_5 | openai: gpt-4o-mini-tts | geko: tokay-kk-v1
TTS_VOICE=                    # elevenlabs voice id (default Rachel 21m00Tcm4TlvDq8ikWAM) | openai: coral | geko: Aigerim
TTS_MODEL_KK=                 # optional Kazakh override, e.g. eleven_v3 (ElevenLabs) — flash v2.5 has no Kazakh
TTS_VOICE_KK=
TTS_SAMPLE_RATE=24000
TTS_SPEED=1.0

# --- Routing policy
FAST_PATH=on                  # on | shadow | off — lexical fast path for obvious informational requests (LLM verifies in the background)
FAST_PATH_MIN_SCORE=0.75
FAST_PATH_MIN_MARGIN=0.35
POLICY_PROCEED_MIN=0.55       # confidence >= → proceed
POLICY_CLARIFY_MIN=0.30       # below → SYS_UNCLEAR (ask instead of guessing)

# ---------- frontend ----------
NEXT_PUBLIC_API_URL=          # empty = same host, port 8080
