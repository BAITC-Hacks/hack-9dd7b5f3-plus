# Runs without keys. Copy to .env at repository root; Compose reads it.
LLM_PROVIDER=mock
SPEECH_PROVIDER=browser
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
# Streaming transcription; manual client VAD commits each turn.
REALTIME_MODEL=gpt-live-transcribe
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_JSON_SCHEMA=true
LLM_TIMEOUT=8s
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
# Compose mounts this directory. Keep paths relative to the repository root.
DATA_PATH=./backend/data/demo
API_PORT=8080
WEB_PORT=3000
# Native Go only (run from backend/). Empty DATABASE_URL = in-memory demo store.
PORT=8080
DATA_DIR=data/demo
DATABASE_URL=
