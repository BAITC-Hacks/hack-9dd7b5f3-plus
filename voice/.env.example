# Voice service — environment variables.
#
# Copy this file to .env and fill in real values locally; never commit a
# real .env. Values are read by hackathon/voice/config: the process
# environment wins, then this file, then the defaults shown below. Keys are
# normalized (trimmed, upper-cased, '-' -> '_'), and several keys accept
# aliases (first non-empty one found wins) to tolerate a messy hand-written
# file, e.g. `eleven-labs=...` is read the same as ELEVEN_LABS=....
# Point VOICE_ENV_FILE at a different path to use this file from elsewhere.

# ---------------------------------------------------------------------------
# ElevenLabs (STT + TTS)
# ---------------------------------------------------------------------------
# Aliases, first non-empty wins: ELEVENLABS_API_KEY, ELEVEN_LABS_API_KEY,
# ELEVEN_LABS, ELEVENLABS, XI_API_KEY.
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# Premade voice "Sarah".
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Defaults to ELEVENLABS_VOICE_ID when empty.
ELEVENLABS_VOICE_ID_KK=
ELEVENLABS_TTS_MODEL_RU=eleven_flash_v2_5
ELEVENLABS_TTS_MODEL_KK=eleven_v3_conversational
ELEVENLABS_TTS_SPEED=1.0
ELEVENLABS_STT_MODEL=scribe_v2_realtime
# "kk" is the measured best for RU, KZ and mixed speech (auto-detect mislabels Kazakh as Turkish).
# Do not add ru as a secondary language: it biases mixed phrases towards Russian.
ELEVENLABS_STT_LANGUAGE=kk
# Comma-separated list, e.g. ru,kk.
ELEVENLABS_STT_SECONDARY_LANGUAGES=
# Comma-separated domain terms to bias recognition towards.
ELEVENLABS_STT_KEYTERMS=Saqta,ОГПО,КАСКО,ДМС,полис,сақтандыру

# Voice activity detection (endpointing + barge-in).
VOICE_VAD_SILENCE_SECS=0.4
# 0 means "use the ElevenLabs server default".
VOICE_VAD_THRESHOLD=0
VOICE_MIN_SPEECH_MS=0
VOICE_MIN_SILENCE_MS=0

# ---------------------------------------------------------------------------
# OpenRouter (LLM)
# ---------------------------------------------------------------------------
# Aliases, first non-empty wins: OPENROUTER_API_KEY, OPENROUTER_API,
# OPENROUTER, OPENROUTER_KEY.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Comma-separated list, tried in order if the primary model fails.
OPENROUTER_FALLBACK_MODELS=openai/gpt-4o-mini,openai/gpt-4.1-nano

# ---------------------------------------------------------------------------
# Brain selection / team backend
# ---------------------------------------------------------------------------
# One of: auto | backend | openrouter | echo
VOICE_BRAIN=auto
# Team backend base URL, e.g. http://backend:8080. Required when
# VOICE_BRAIN=backend.
BACKEND_URL=
# Directory holding the starter-kit data (scenarios.json etc). Empty means
# "auto-discover by walking up from the working directory for data/scenarios.json".
VOICE_DATA_DIR=

# ---------------------------------------------------------------------------
# Server / transports
# ---------------------------------------------------------------------------
# Empty means ":"+PORT if PORT is set, else ":8090".
VOICE_HTTP_ADDR=
PORT=
# Empty disables the Asterisk AudioSocket phone transport, e.g. ":9092".
VOICE_AUDIOSOCKET_ADDR=
# https base URL this service is reachable at, used in Twilio TwiML.
VOICE_PUBLIC_URL=
# Comma-separated list of allowed CORS origins.
VOICE_ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# Logging / latency tuning
# ---------------------------------------------------------------------------
VOICE_LOG_DIR=logs/voice
VOICE_RECORD_AUDIO=false
VOICE_CACHE_DIR=cache/voice
VOICE_SPECULATIVE=true
VOICE_SPECULATIVE_TTS=false
VOICE_SPECULATE_AFTER_MS=250
# 0 disables the filler phrase.
VOICE_FILLER_AFTER_MS=1500
VOICE_BARGE_IN=true
VOICE_BARGE_IN_VAD=false
VOICE_GREETING=true

# Optional: point at a specific .env file instead of walking up from the
# working directory to find one.
VOICE_ENV_FILE=
