# Copy to core-llm/.env (gitignored). Never commit real keys.
OPENROUTER_API_KEY=
# Model id on OpenRouter. See README for the benchmark.
ROUTER_MODEL=google/gemini-2.5-flash-lite
# OpenRouter provider routing: latency | throughput | price | (empty = OpenRouter default)
ROUTER_PROVIDER_SORT=latency
# Confidence (0-100) from which a scenario counts as requested; below it the primary becomes "clarify".
ROUTER_THRESHOLD=60
# Per-request HTTP timeout in seconds.
ROUTER_TIMEOUT=8
