# Server-side speech recognition fallback (/api/stt). Copy to .env.local, never commit .env.local.
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# mock (no keys) | core (Python LLM + demo actions) | real (Go SSE API)
NEXT_PUBLIC_API_MODE=core
# Server-only URL. Never prefix this or API keys with NEXT_PUBLIC_.
CORE_LLM_URL=http://127.0.0.1:8090
